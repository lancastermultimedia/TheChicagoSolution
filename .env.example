# Google Cloud Console → enable "Maps JavaScript API" + "Places API (New)" →
# create an API key. Safe to expose client-side (restrict by HTTP referrer
# once deployed, per CLAUDE.md) — not a secret in the traditional sense.
VITE_GOOGLE_PLACES_KEY=

# Supabase project settings → API. The anon/publishable key is meant to be
# client-visible — access is enforced by RLS policies, not key secrecy.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
